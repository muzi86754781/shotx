                                        <Button Content="⏻ 退出 ShotX" Style="{StaticResource SmallBtnStyle}" Click="BtnExit_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 功能亮点与介绍 (图 10 逐字对齐) -->
                                <TextBlock Text="功能亮点与介绍:" FontSize="12" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,8"/>
                                <TextBlock LineHeight="20" FontSize="11" Foreground="#555555" TextWrapping="Wrap">
                                    · 全能辅助截图：支持放大镜取色、九宫格比例网格与常用分辨率快速框选。<LineBreak/>
                                    · 区域 / 窗口 / 全屏 / 定时截图：多维度即时捕捉，支持阴影与圆角实时调整。<LineBreak/>
                                    · 滚动长截图：在截图区域内滑动鼠标，实时检测滚动变化并无缝拼接长图。<LineBreak/>
                                    · 截图 OCR：框选屏幕即刻离线识别文字并自动复制到剪贴板，无多余干扰。<LineBreak/>
                                    · 屏幕与音频录制：高清录屏（摄像头/声音/光标/按键高亮），以及独立麦克风录音。<LineBreak/>
                                    · 多模态翻译：支持划词翻译、截图翻译与输入翻译窗口，中英互换与 TTS 朗读。<LineBreak/>
                                    · 剪贴板历史：自动记录复制内容，支持按类检索、快速粘贴与多格式管理。<LineBreak/>
                                    · 贴图置顶 &amp; 拾色器 &amp; 隐藏桌面图标：让桌面井然有序，提升日常生产力。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
