                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="Alt + F3" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 8. 拾色器 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="拾色器" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="放大镜精准吸管取色，按 R 键拷贝 RGB，按 H 键拷贝 HEX" FontSize="10" Foreground="#888888"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="Alt + Shift + C" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 9. 屏幕录制 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="屏幕录制" FontSize="12" FontWeight="SemiBold"/>
