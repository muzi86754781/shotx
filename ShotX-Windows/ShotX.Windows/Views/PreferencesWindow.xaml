                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ShotX v1.9.23" FontSize="14.5" FontWeight="Bold" Foreground="#1E2024"/>
                                        <TextBlock Text="开发者: @muzi86754781 · github.com/muzi86754781/shotx · QQ: 285351298" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
