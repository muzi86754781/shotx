<Window x:Class="ShotX.Windows.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 设置中心"
        Width="920"
        Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Resources/app.ico"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- Windows 11 顶部Tab切换样式 -->
        <Style x:Key="SegmentBtnStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#0067C0"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 左侧导航栏按钮样式 -->
        <Style x:Key="Win11NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="12,9">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="16" CornerRadius="1.5" Background="Transparent" HorizontalAlignment="Left" Margin="-6,0,0,0"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter TargetName="bar" Property="Background" Value="#0067C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 历史记录过滤胶囊样式 -->
        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0067C0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0067C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 卡片容器样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 次要按钮样式 -->
        <Style x:Key="SmallBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 主强调色按钮样式 -->
        <Style x:Key="AccentBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#0067C0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005BA8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#004E92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 支持作者胶囊按钮 -->
        <Style x:Key="PrimaryPillBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D97706"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 现代拨动开关 ToggleSwitch 样式 -->
        <Style x:Key="Win11ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtState" Text="已关闭" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border x:Name="track" Width="44" Height="22" CornerRadius="11" Background="#CBD5E1" BorderBrush="#94A3B8" BorderThickness="1">
                                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#0067C0"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#0067C0"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="txtState" Property="Text" Value="已开启"/>
                                <Setter TargetName="txtState" Property="Foreground" Value="#0067C0"/>
                                <Setter TargetName="txtState" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 标题栏控制按钮样式 -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷键键帽输入框样式 -->
        <Style x:Key="KeycapBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="108"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Windows 11 Fluent 主窗口外壳 -->
    <Border Background="#F3F6FB" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Windows 11 顶部标题栏 -->
                <RowDefinition Height="*"/>  <!-- 左右分栏主体区 -->
            </Grid.RowDefinitions>

            <!-- 1. Windows 11 风格顶部标题栏 (可拖动) -->
            <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="#F8FAFC" CornerRadius="12,12,0,0" MouseDown="TopBar_MouseDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：软件图标与标题 (与 Mac 端图标完全一致) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/icon.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                        <TextBlock Text="ShotX 设置中心" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.9.29" FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                        </Border>
                    </StackPanel>

                    <!-- 中央分段切换器: [ 偏好设置 ] [ 历史记录 ] -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#E2E8F0" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabSettings" Content="⚙️  偏好设置" Style="{StaticResource SegmentBtnStyle}" IsChecked="True" Checked="TabSettings_Checked"/>
                            <RadioButton x:Name="TabHistory" Content="🕘  历史记录" Style="{StaticResource SegmentBtnStyle}" Checked="TabHistory_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：标准 Windows 11 最小化与关闭按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionBtnStyle}" Click="BtnMinimize_Click" ToolTip="最小化">
                            <TextBlock Text="─" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseBtnStyle}" Margin="2,0,0,0" Click="BtnClose_Click" ToolTip="关闭">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 主体区：左侧 Windows 11 导航栏 + 右侧内容画布 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="215"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧 Windows 11 Fluent 侧边导航栏 -->
                <Border Grid.Column="0" Background="#EEF2F8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" CornerRadius="0,0,0,12" Padding="12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 品牌信息卡片 -->
                        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Resources/icon.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ShotX" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="全能截图 · 录屏 · 翻译" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 分类快速导航菜单 -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="功能导航" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="8,0,0,6"/>
                            <Button Style="{StaticResource Win11NavBtnStyle}" Click="NavGeneral_Click" Content="⚙️   通用与存储路径"/>
                            <Button Style="{StaticResource Win11NavBtnStyle}" Click="NavAi_Click" Content="🌐   识别与翻译服务"/>
                            <Button Style="{StaticResource Win11NavBtnStyle}" Click="NavHotkeys_Click" Content="⌨️   全局快捷键配置"/>
                            <Button Style="{StaticResource Win11NavBtnStyle}" Click="NavHistory_Click" Content="🕘   历史记录管理"/>
                            <Button Style="{StaticResource Win11NavBtnStyle}" Click="NavAbout_Click" Content="ℹ️   关于 ShotX"/>
                        </StackPanel>

                        <!-- 侧栏底部快捷操作 -->
                        <StackPanel Grid.Row="2">
                            <Separator Background="#E2E8F0" Margin="0,0,0,10"/>
                            <Button Content="☕  支持作者" Style="{StaticResource PrimaryPillBtnStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnSupport_Click"/>
                            <Button Content="⏻  退出 ShotX" Style="{StaticResource SmallBtnStyle}" HorizontalAlignment="Stretch" Click="BtnExit_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 右侧主内容区 -->
                <Grid Grid.Column="1">
                    <!-- ================= TAB 1: 历史记录管理器 ================= -->
                    <Grid x:Name="ViewHistory" Visibility="Collapsed" Margin="20,14,20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/> <!-- 第 1 行：分类过滤胶囊选项卡 -->
                            <RowDefinition Height="44"/> <!-- 第 2 行：独立搜索框与统计条 (解决需求 9 搜索框挡住选项卡问题) -->
                            <RowDefinition Height="*"/>  <!-- 第 3 行：美化卡片列表 / 空状态 -->
                        </Grid.RowDefinitions>

                        <!-- 第 1 行：分类过滤胶囊选项卡 (完全独立独占一行，清空按钮移至搜索栏，绝不挡住任何选项卡 - 解决需求 5) -->
                        <Grid Grid.Row="0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="PillAll" Content="⊞ 全部" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillScreenshot" Content="🖼️ 截图" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillRecord" Content="📹 录屏" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" IsChecked="True" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillAudio" Content="🎙️ 录音" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillOcr" Content="🔤 提取文字" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillTranslation" Content="🌐 翻译" Style="{StaticResource FilterPillStyle}" Margin="0,0,6,0" Checked="HistoryFilter_Changed"/>
                                    <RadioButton x:Name="PillClipboard" Content="📋 剪贴板" Style="{StaticResource FilterPillStyle}" Checked="HistoryFilter_Changed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- 第 2 行：独立搜索框、记录数统计与清空分类操作 (整齐排列在一行，宽敞直观且绝不遮挡选项卡 - 解决需求 5) -->
                        <Grid Grid.Row="1" Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Height="32" Padding="12,0">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11.5" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtHistorySearch" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center" TextChanged="TxtHistorySearch_TextChanged"/>
                                    <TextBlock x:Name="TxtHistoryPlaceholder" Grid.Column="1" Text="输入关键词搜索截图、录屏、录音、OCR 文字、翻译或剪贴板记录..." FontSize="12" Foreground="#94A3B8"
                                               IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="#EEF2F8" CornerRadius="8" Padding="12,0" Height="32" Margin="10,0,0,0">
                                <TextBlock x:Name="TxtHistoryCount" Text="录屏 · 共 0 条记录" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            </Border>

                            <Button Grid.Column="2" Content="🗑️ 清空当前分类" Style="{StaticResource SmallBtnStyle}" Height="32" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Click="BtnClearCurrentHistory_Click"/>
                        </Grid>

                        <!-- 第 3 行：内容展示区 (参照 macOS 端卡片样式，增加缩略图、双语翻译卡片与直达打开 - 解决需求 7) -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <!-- 空状态展示 -->
                            <Border x:Name="PanelEmptyHistory" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="#EFF6FF" CornerRadius="20" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                                        <TextBlock x:Name="TxtEmptyIcon" Text="📹" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="TxtEmptyTitle" Text="暂无录屏记录" FontSize="15" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="使用 ShotX 截图、录屏、录音、OCR 或翻译后，历史记录将自动归档于此" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 有数据时的现代化卡片列表 (含缩略图、双语对照与直达打开) -->
                            <ListBox x:Name="LstFullHistory" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                        <Setter Property="Template">
                                             <Setter.Value>
                                                 <ControlTemplate TargetType="ListBoxItem">
                                                     <ContentPresenter/>
                                                 </ControlTemplate>
                                             </Setter.Value>
                                         </Setter>
                                     </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,10">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#0F172A"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 左侧多媒体缩略图 / 类型卡片 (参照 macOS 端样式) -->
                                                <Border Grid.Column="0" Background="{Binding BadgeBackground}" CornerRadius="8" Width="70" Height="52"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True" BorderBrush="#CBD5E1" BorderThickness="0.8">
                                                    <Grid>
                                                        <!-- 真实图片文件缩略图 -->
                                                        <Image Source="{Binding FilePath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding ImageThumbnailVisibility}"/>

                                                        <!-- 无缩略图或非图片记录时的图标占位 -->
                                                        <Border Background="{Binding BadgeBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                Visibility="{Binding PlaceholderBadgeVisibility}">
                                                            <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- 录屏角标 -->
                                                        <Border Visibility="{Binding MediaBadgeVisibility}"
                                                                Background="#B3000000" CornerRadius="4" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3">
                                                            <TextBlock Text="▶ 视频" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- 中间：分为双语翻译展示卡片与普通结构化卡片 (解决需求 7) -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,14,0">
                                                    <!-- 1. 翻译记录专属双语展示卡片 (显示双语言内容，点击打开可直接打开翻译框并显示内容) -->
                                                    <StackPanel Visibility="{Binding TranslationCardVisibility}">
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Left" Background="#F3E8FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="🌐 翻译记录" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED"/>
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimestampString}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                            <TextBlock Text="中英双向互译" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                        </DockPanel>

                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{Binding TranslationSource, StringFormat='源：{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Row="1" Text="{Binding TranslationTarget, StringFormat='译：{0}'}" FontSize="12" FontWeight="Medium" Foreground="#16A34A" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- 2. 普通历史记录展示 (截图/录屏/录音/OCR/剪贴板) -->
                                                    <StackPanel Visibility="{Binding StandardCardVisibility}">
                                                        <DockPanel LastChildFill="True">
                                                            <Border DockPanel.Dock="Left" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TypeBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                            </Border>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimestampString}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>

                                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- 右侧操作按钮组 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="打开" Style="{StaticResource AccentBtnStyle}" Padding="11,4" Margin="0,0,6,0" Tag="{Binding}" Click="BtnOpenHistoryItem_Click" ToolTip="打开文件或直接进入翻译窗口"/>
                                                    <Button Content="复制" Style="{StaticResource SmallBtnStyle}" Padding="10,4" Margin="0,0,6,0" Tag="{Binding}" Click="BtnCopyHistoryItem_Click" ToolTip="复制文本或文件路径"/>
                                                    <Button Content="目录" Visibility="{Binding FileActionVisibility}" Style="{StaticResource SmallBtnStyle}" Padding="10,4" Margin="0,0,6,0" Tag="{Binding}" Click="BtnRevealHistoryItem_Click" ToolTip="在资源管理器中定位"/>
                                                    <Button Content="删除" Style="{StaticResource SmallBtnStyle}" Foreground="#DC2626" BorderBrush="#FECACA" Padding="10,4" Tag="{Binding}" Click="BtnDeleteHistoryItem_Click" ToolTip="删除此条记录"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- ================= TAB 2: Windows 11 风格偏好设置 ================= -->
                    <ScrollViewer x:Name="ViewSettings" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                        <StackPanel>
                            <!-- 卡片 1: 通用设置 -->
                            <Border x:Name="CardGeneral" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#EFF6FF" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                            <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="通用设置" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="管理 Windows 系统登录自启与常驻后台行为" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,130,0">
                                            <TextBlock Text="开机自动启动 ShotX" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="登录 Windows 后自动在系统托盘静默运行，随时响应全局截图与录屏快捷键" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoStart" Style="{StaticResource Win11ToggleSwitchStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ChkAutoStart_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 2: 截图保存与格式设置 -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#F0FDF4" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                            <TextBlock Text="🖼️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="截图与图像保存" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="默认保存到系统下载目录 (Downloads)，支持自由更改自定义保存路径" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- 保存格式 -->
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="默认图像编码格式" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="支持 PNG (无损透明推荐)、JPG (高压缩小体积)、WEBP" FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbImageFormat" HorizontalAlignment="Right" VerticalAlignment="Center" Width="165" Height="30" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="CmbImageFormat_SelectionChanged">
                                            <ComboBoxItem Content="PNG (无损高质量)"/>
                                            <ComboBoxItem Content="JPG (体积小)"/>
                                            <ComboBoxItem Content="WEBP (高效压缩)"/>
                                        </ComboBox>
                                    </Grid>

                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- 截图保存路径 -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                            <TextBlock Text="截图默认保存路径" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,5,0,4" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtSavePath" Text="C:\Users\Administrator\Downloads" FontSize="11.5" FontFamily="Consolas, Microsoft YaHei" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Text="所有区域截图、窗口截图、全屏截图与长截图均默认自动保存至此目录" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="更改目录..." Style="{StaticResource AccentBtnStyle}" Margin="0,0,8,0" Click="BtnChangeSavePath_Click"/>
                                            <Button Content="打开文件夹" Style="{StaticResource SmallBtnStyle}" Click="BtnOpenSavePath_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 3: 录屏与录音保存设置 -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#FEF2F2" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                            <TextBlock Text="🎥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="录屏与录音存储路径" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="配置屏幕录制 (MP4/GIF) 与麦克风声音录制 (WAV) 的保存目录" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- 录屏保存路径 -->
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                            <TextBlock Text="⏺  屏幕录制保存路径" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,5,0,4" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtRecordPath" Text="C:\Users\Administrator\Downloads" FontSize="11.5" FontFamily="Consolas, Microsoft YaHei" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Text="屏幕录制完成后，视频文件 (MP4) 或动图 (GIF) 将自动保存至此目录" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="更改目录..." Style="{StaticResource AccentBtnStyle}" Margin="0,0,8,0" Click="BtnChangeRecordPath_Click"/>
                                            <Button Content="打开文件夹" Style="{StaticResource SmallBtnStyle}" Click="BtnOpenRecordPath_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- 录音保存路径 -->
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                            <TextBlock Text="🎙️  声音录制保存路径" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,5,0,4" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtAudioPath" Text="C:\Users\Administrator\Downloads" FontSize="11.5" FontFamily="Consolas, Microsoft YaHei" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <TextBlock Text="麦克风录音结束后，音频文件 (WAV) 将自动保存至此目录" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="更改目录..." Style="{StaticResource AccentBtnStyle}" Margin="0,0,8,0" Click="BtnChangeAudioPath_Click"/>
                                            <Button Content="打开文件夹" Style="{StaticResource SmallBtnStyle}" Click="BtnOpenAudioPath_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 4: 文本识别 (OCR) 与翻译平台 (多引擎可配置与信息保留，参照设计图) -->
                            <Border x:Name="CardAi" Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Background="#F5F3FF" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                            <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="机器翻译与文字识别 (OCR) 服务配置" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="支持多平台翻译与 OCR 引擎自由切换，独立配置各平台 API 凭证并持久保留" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Separator Background="#F1F5F9" Margin="0,0,0,12"/>

                                    <!-- 1. 机器翻译平台 (1:1 还原用户参考设计图布局 - 解决需求 3) -->
                                    <TextBlock Text="多语言机器翻译平台" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="220" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="195"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧翻译引擎列表 (带复选框、图标、平台名称与免费/秘钥角标) -->
                                            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="#FFFFFF" CornerRadius="8,0,0,8">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="PnlTransEngines" Margin="0,4">
                                                        <!-- 百度翻译 (免费 / 内置) -->
                                                        <Border x:Name="RowTransBuiltIn" Background="Transparent" Padding="10,8" Margin="4,2" CornerRadius="4" Cursor="Hand" MouseDown="TransEngineRow_MouseDown" Tag="BuiltIn">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ChkTransBuiltIn" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="18" Height="18" Background="#007AFF" CornerRadius="3" Margin="0,0,6,0">
                                                                        <TextBlock Text="译" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock x:Name="TxtTitleTransBuiltIn" Text="百度翻译" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="#22C55E" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                    <TextBlock Text="免费" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 百度翻译 (官方 API 秘钥) -->
                                                        <Border x:Name="RowTransBaidu" Background="#007AFF" Padding="10,8" Margin="4,2" CornerRadius="4" Cursor="Hand" MouseDown="TransEngineRow_MouseDown" Tag="Baidu">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ChkTransBaidu" IsHitTestVisible="False" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="18" Height="18" Background="#007AFF" CornerRadius="3" Margin="0,0,6,0">
                                                                        <TextBlock Text="译" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <TextBlock x:Name="TxtTitleTransBaidu" Text="百度翻译" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="#0284C7" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                    <TextBlock Text="秘钥" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- 谷歌翻译 (官方 API 秘钥) -->
                                                        <Border x:Name="RowTransGoogle" Background="Transparent" Padding="10,8" Margin="4,2" CornerRadius="4" Cursor="Hand" MouseDown="TransEngineRow_MouseDown" Tag="Google">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ChkTransGoogle" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="G" FontWeight="Bold" FontSize="12.5" Foreground="#EA4335" Margin="2,0,6,0"/>
                                                                    <TextBlock x:Name="TxtTitleTransGoogle" Text="谷歌翻译" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="#0284C7" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                    <TextBlock Text="秘钥" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- DeepL 翻译 (官方 API 秘钥) -->
                                                        <Border x:Name="RowTransDeepL" Background="Transparent" Padding="10,8" Margin="4,2" CornerRadius="4" Cursor="Hand" MouseDown="TransEngineRow_MouseDown" Tag="DeepL">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ChkTransDeepL" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="D" FontWeight="Bold" FontSize="12.5" Foreground="#0F2B46" Margin="2,0,6,0"/>
                                                                    <TextBlock x:Name="TxtTitleTransDeepL" Text="DeepL 翻译" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="#0284C7" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                    <TextBlock Text="秘钥" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- OpenAI 翻译 (兼容 API 秘钥) -->
                                                        <Border x:Name="RowTransOpenAI" Background="Transparent" Padding="10,8" Margin="4,2" CornerRadius="4" Cursor="Hand" MouseDown="TransEngineRow_MouseDown" Tag="OpenAI">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox x:Name="ChkTransOpenAI" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="🤖" FontSize="12" Margin="0,0,6,0"/>
                                                                    <TextBlock x:Name="TxtTitleTransOpenAI" Text="OpenAI 翻译" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="#0284C7" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                    <TextBlock Text="秘钥" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>

                                            <!-- 右侧翻译配置表单 (1:1 还原用户参考设计图布局) -->
                                            <Grid Grid.Column="1" Margin="18,14,18,12">
                                                <!-- 百度翻译 (秘钥) 配置 -->
                                                <StackPanel x:Name="PnlCfgTransBaidu" Visibility="Visible">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="APP ID:" HorizontalAlignment="Left" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
