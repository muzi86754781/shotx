                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="Alt + Shift + R" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
