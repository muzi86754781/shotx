                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="Alt + Shift + F" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 12. 截图翻译 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="截图翻译" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="框选屏幕区域后自动提取文字并立即打开翻译框进行翻译" FontSize="10" Foreground="#888888"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="未设置" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 13. 剪贴板历史 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="剪贴板历史" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="随时呼出历史剪贴板记录，支持搜索、双击直接粘贴在光标处" FontSize="10" Foreground="#888888"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="未设置" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 14. 改图-从剪贴板打开 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="改图-从剪贴板打开" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="从剪贴板直接载入图片并打开标注窗口，支持画笔、文字、马赛克等就地编辑" FontSize="10" Foreground="#888888"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="Alt + P" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 15. 隐藏桌面图标 -->
                                    <Grid Margin="0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="隐藏桌面图标" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="💡 功能说明: 一键隐藏或恢复桌面上所有文件与快捷方式，录屏或截图时桌面整洁干净" FontSize="10" Foreground="#888888"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBox Text="未设置" Width="90" Height="24" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="11" Background="#F2F3F5" BorderBrush="#DCDFE6"/>
                                            <Button Content="清除" Style="{StaticResource SmallBtnStyle}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 底部操作与说明 (图 10) -->
                                <Separator Background="#F4F5F7" Margin="0,8,0,8"/>
                                <Grid>
                                    <TextBlock Text="点击输入框并按下新的组合键。按 Esc 键取消。" FontSize="10.5" Foreground="#888888" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="清空全部" Style="{StaticResource SmallBtnStyle}" Margin="0,0,6,0" Click="BtnClearHotkeys_Click"/>
                                        <Button Content="恢复全部默认" Style="{StaticResource SmallBtnStyle}" Click="BtnRestoreHotkeys_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片 7: 关于 ShotX (图 10 像素级实现) -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="ℹ️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="关于 ShotX" FontSize="13.5" FontWeight="Bold" Foreground="#1E2024"/>
                                        <TextBlock Text="现代 Windows 全能屏幕截图、就地标注、长截图与录屏录音工具" FontSize="10.5" Foreground="#888888" Margin="0,2,0,0"/>
