<Window x:Class="ShotX.Windows.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 偏好设置"
        Width="580"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="ShotX 偏好设置" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F" />
                <TextBlock Text="配置快捷键、截图美化、保存目录及实用工具" FontSize="12" Foreground="#86868B" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- 1. 常规设置 -->
            <TabItem Header="常规设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E5E5EA" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="基础偏好" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12" />
                                <CheckBox x:Name="ChkAutoStart" Content="开机自动启动 ShotX" Click="ChkAutoStart_Click" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkPlaySound" Content="截屏完成后播放快门提示音" Click="ChkPlaySound_Click" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkShadow" Content="默认开启截图外阴影" Click="ChkShadow_Click" Margin="0,0,0,10" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E5E5EA" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="保存位置与格式" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12" />
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="默认保存目录:" VerticalAlignment="Center" Width="100" />
                                    <Button DockPanel.Dock="Right" Content="浏览..." Width="60" Margin="8,0,0,0" Click="BtnBrowseSavePath_Click" />
                                    <TextBox x:Name="TxtSavePath" IsReadOnly="True" VerticalAlignment="Center" />
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock Text="默认图片格式:" VerticalAlignment="Center" Width="100" />
                                    <ComboBox x:Name="CmbImageFormat" Width="120" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="CmbImageFormat_SelectionChanged">
                                        <ComboBoxItem Content="PNG (推荐)" />
                                        <ComboBoxItem Content="JPEG" />
                                        <ComboBoxItem Content="BMP" />
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 全局快捷键 -->
            <TabItem Header="全局快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Background="White" CornerRadius="8" Padding="16" BorderBrush="#E5E5EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="热键映射表" FontSize="14" FontWeight="SemiBold" Foreground="#1D1D1F" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="区域截图:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="Alt + A" IsReadOnly="True" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="滚动长截图:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="Alt + S" IsReadOnly="True" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="改图 (从剪贴板打开):" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="Alt + P" IsReadOnly="True" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="翻译窗口:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="Alt + V" IsReadOnly="True" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="剪贴板历史:" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="Alt + C" IsReadOnly="True" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- 3. 关于与技术支持 -->
            <TabItem Header="关于 ShotX">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Border Background="White" CornerRadius="8" Padding="20" BorderBrush="#E5E5EA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ShotX for Windows" FontSize="18" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,0,6" />
                            <TextBlock Text="专业、优雅的屏幕截图、长截图、标注、贴图与文字识别工具" FontSize="12" Foreground="#86868B" Margin="0,0,0,16" />

                            <Separator Margin="0,0,0,16" />

                            <TextBlock Text="版本: v1.9.30 (Windows 64-bit 原生版)" FontSize="13" Foreground="#1D1D1F" Margin="0,0,0,8" />
                            <TextBlock Text="技术架构: C# .NET 8 + WPF + Direct2D + WinRT OCR" FontSize="12" Foreground="#86868B" Margin="0,0,0,8" />
                            <TextBlock Text="开发者技术支持 QQ 群: 285351298" FontSize="13" Foreground="#007AFF" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="官方代码仓库: https://github.com/muzi86754781/shotx" FontSize="12" Foreground="#86868B" Margin="0,0,0,16" />

                            <TextBlock Text="与 macOS 版保持 1:1 一模一样的核心算法、标注图元与交互体验。" FontSize="12" Foreground="#34C759" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Width="80" Height="30" Background="#007AFF" Foreground="White" BorderThickness="0" Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
