<Window x:Class="ShotX.Windows.Views.SupportAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持作者 · ShotX"
        Width="580" Height="490"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="22" Background="#FFF5E6">
                <TextBlock Text="☕" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="支持与赞赏作者" FontSize="18" FontWeight="Bold" Foreground="#1D1D1F" />
                <TextBlock Text="ShotX 独立开发不易 · 感恩一路温暖相伴" FontSize="12" Foreground="#86868B" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Content Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <!-- Left: Author story -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1" Padding="14" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="作者心声" FontSize="13.5" FontWeight="SemiBold" Foreground="#007AFF" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="#3A3A3C">
                        ShotX 追求丝滑、小巧、纯净与高效。从全能截图、几何标注、滚动长截图实时拼接、离线 OCR，到划词/截图/输入多模态翻译、剪贴板历史与屏幕录制，无数个夜晚与周末都在代码调试和体验打磨中度过。
                        &#x0a;&#x0a;ShotX 坚持永久纯净、无任何广告。您的认可与赞赏，是作者持续迭代与维护的最大动力！如果 ShotX 为您的日常工作带来了哪怕一点点便利，欢迎请作者喝杯咖啡 ☕️！
                    </TextBlock>
                    <Separator Margin="0,12" Background="#E5E5EA" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="开发者: @muzi86754781   QQ: 285351298" FontSize="11.5" Foreground="#86868B" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right: WeChat QR Code -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1" Padding="12" Margin="0,0,0,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="8" ClipToBounds="True" Width="180" Height="220" Background="#F2F2F7">
                        <Image x:Name="ImgQrCode" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="微信扫一扫 赞赏作者" FontSize="12" FontWeight="SemiBold" Foreground="#34C759" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="访问 GitHub" Height="34" Padding="16,0" Margin="0,0,10,0"
                    Background="#F2F2F7" Foreground="#1D1D1F" BorderBrush="#D2D2D7" BorderThickness="1"
                    Click="BtnGitHub_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="关闭" Height="34" Padding="20,0"
                    Background="#007AFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>

