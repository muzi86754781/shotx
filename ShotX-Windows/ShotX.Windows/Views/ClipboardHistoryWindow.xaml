<Window x:Class="ShotX.Windows.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 剪贴板历史"
        Width="460"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app.ico"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 美化后的行内复制图标按钮样式 (解决需求 8) -->
        <Style x:Key="RowCopyBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                            <Path x:Name="ico"
                                  Data="M 8,3 L 16,3 C 17.1,3 18,3.9 18,5 L 18,14 C 18,15.1 17.1,16 16,16 L 8,16 C 6.9,16 6,15.1 6,14 L 6,5 C 6,3.9 6.9,3 8,3 Z M 4,7 L 4,18 C 4,19.1 4.9,20 6,20 L 14,20"
                                  Stroke="#0067C0" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0067C0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0067C0"/>
                                <Setter TargetName="ico" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 美化后的行内删除图标按钮样式 (解决需求 8) -->
        <Style x:Key="RowDeleteBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6">
                            <Path x:Name="ico"
                                  Data="M 4,6 L 20,6 M 9,6 L 9,4 C 9,3.4 9.4,3 10,3 L 14,3 C 14.6,3 15,3.4 15,4 L 15,6 M 6,6 L 7,19 C 7,20.1 7.9,21 9,21 L 15,21 C 16.1,21 17,20.1 17,19 L 18,6 M 10,10 L 10,17 M 14,10 L 14,17"
                                  Stroke="#DC2626" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="ico" Property="Stroke" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外壳 -->
    <Border Background="#F3F6FB" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.24" Color="#0F172A"/>
        </Border.Effect>
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/> <!-- 顶栏 -->
                <RowDefinition Height="38"/> <!-- 搜索框 -->
                <RowDefinition Height="*"/>  <!-- 列表 -->
                <RowDefinition Height="30"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏 (可拖拽) -->
            <Grid Grid.Row="0" MouseDown="TopBar_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform" Fill="#0067C0"
                          Data="M 19,3 L 14.8,3 C 14.4,1.8 13.3,1 12,1 C 10.7,1 9.6,1.8 9.2,3 L 5,3 C 3.9,3 3,3.9 3,5 L 3,19 C 3,20.1 3.9,21 5,21 L 19,21 C 20.1,21 21,20.1 21,19 L 21,5 C 21,3.9 20.1,3 19,3 Z  M 12,3 C 12.6,3 13,3.4 13,4 C 13,4.6 12.6,5 12,5 C 11.4,5 11,4.6 11,4 C 11,3.4 11.4,3 12,3 Z  M 19,19 L 5,19 L 5,5 L 7,5 L 7,7 L 17,7 L 17,5 L 19,5 Z"/>
                    <TextBlock Text="剪贴板历史" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" Style="{StaticResource IconBtnStyle}" Width="26" Height="26" Click="BtnClose_Click" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- 2. 搜索框 -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,4,0,8" Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock x:Name="TxtPlaceholder" Grid.Column="1" Text="搜索剪贴板记录..." FontSize="12" Foreground="#94A3B8"
                               IsHitTestVisible="False" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 3. 历史记录列表 -->
            <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4">
                <Grid>
                    <ListBox x:Name="LstHistory" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="LstHistory_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#F8FAFC"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="#93C5FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧分类图标 -->
                                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="6" Width="26" Height="26" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <Path Data="M 6,4 L 14,4 L 18,8 L 18,19 C 18,19.6 17.6,20 17,20 L 6,20 C 5.4,20 5,19.6 5,19 L 5,5 C 5,4.4 5.4,4 6,4 Z M 13,4 L 13,9 L 18,9"
                                              Stroke="#0067C0" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 标题与内容摘要 -->
                                    <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Snippet}" FontSize="11.5" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TimeString}" FontSize="10.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- 右侧快捷操作按钮：默认隐藏，仅当鼠标悬停在当前行时显示 (解决需求 8) -->
                                    <StackPanel x:Name="RowActionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Button Style="{StaticResource RowCopyBtnStyle}" Tag="{Binding}" Click="BtnItemCopy_Click" ToolTip="复制此条内容"/>
                                        <Button Style="{StaticResource RowDeleteBtnStyle}" Margin="6,0,0,0" Tag="{Binding}" Click="BtnItemDelete_Click" ToolTip="删除此条记录"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="RowActionButtons" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态提示 -->
                    <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" Opacity="0.6"/>
                        <TextBlock Text="暂无匹配的剪贴板记录" FontSize="12.5" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 操作反馈 Toast 提示条 (复制 / 粘贴 / 删除提示) -->
                    <Border x:Name="ToastBanner" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,12" CornerRadius="16" Padding="14,6" Background="#E60F172A" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtToastMessage" Text="✓ 已复制到剪贴板" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. 底部状态栏 -->
            <Grid Grid.Row="3" Margin="4,6,4,0">
                <TextBlock x:Name="TxtFooter" Text="双击任意记录直接粘贴到光标位置 · 0 条记录"
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="清空全部" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11.5" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnClearAll_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
