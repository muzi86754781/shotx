<Window x:Class="ShotX.Windows.Views.AllInOneBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全能截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="480"
        Height="80"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 底部悬浮深色胶囊条 -->
    <Border Margin="10" Background="#EE1E2127" CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. 区域 -->
            <Button Grid.Column="0" Style="{StaticResource ActionButtonStyle}" Click="Area_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 3,3 L 7,3 L 7,5 L 5,5 L 5,7 L 3,7 Z  M 17,3 L 21,3 L 21,7 L 19,7 L 19,5 L 17,5 Z  M 3,17 L 5,17 L 5,19 L 7,19 L 7,21 L 3,21 Z  M 19,17 L 21,17 L 21,21 L 17,21 L 17,19 L 19,19 Z  M 9,4 L 15,4 L 15,5.5 L 9,5.5 Z  M 9,18.5 L 15,18.5 L 15,20 L 9,20 Z  M 4,9 L 5.5,9 L 5.5,15 L 4,15 Z  M 18.5,9 L 20,9 L 20,15 L 18.5,15 Z"/>
                    <TextBlock Text="区域" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 2. 全屏 -->
            <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Click="Fullscreen_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 3,4 C 2.4,4 2,4.4 2,5 L 2,16 C 2,16.6 2.4,17 3,17 L 10,17 L 10,19 L 7,19 C 6.5,19 6.5,20.5 7,20.5 L 17,20.5 C 17.5,20.5 17.5,19 17,19 L 14,19 L 14,17 L 21,17 C 21.6,17 22,16.6 22,16 L 22,5 C 22,4.4 21.6,4 21,4 Z  M 4,6 L 20,6 L 20,15 L 4,15 Z"/>
                    <TextBlock Text="全屏" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 3. 窗口 -->
            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Click="Window_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 3,4 C 2.4,4 2,4.4 2,5 L 2,19 C 2,19.6 2.4,20 3,20 L 21,20 C 21.6,20 22,19.6 22,19 L 22,5 C 22,4.4 21.6,4 21,4 Z  M 4,8.5 L 20,8.5 L 20,18.5 L 4,18.5 Z  M 5,6.2 C 5,5.7 5.4,5.3 5.9,5.3 C 6.4,5.3 6.8,5.7 6.8,6.2 C 6.8,6.7 6.4,7.1 5.9,7.1 C 5.4,7.1 5,6.7 5,6.2 Z  M 8,6.2 C 8,5.7 8.4,5.3 8.9,5.3 C 9.4,5.3 9.8,5.7 9.8,6.2 C 9.8,6.7 9.4,7.1 8.9,7.1 C 8.4,7.1 8,6.7 8,6.2 Z  M 11,6.2 C 11,5.7 11.4,5.3 11.9,5.3 C 12.4,5.3 12.8,5.7 12.8,6.2 C 12.8,6.7 12.4,7.1 11.9,7.1 C 11.4,7.1 11,6.7 11,6.2 Z"/>
                    <TextBlock Text="窗口" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 4. 上一区域 -->
            <Button Grid.Column="3" Style="{StaticResource ActionButtonStyle}" Click="LastArea_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 12,4 C 7.6,4 4,7.6 4,12 L 1.5,12 L 5,16.5 L 8.5,12 L 6,12 C 6,8.7 8.7,6 12,6 C 15.3,6 18,8.7 18,12 C 18,15.3 15.3,18 12,18 C 10.3,18 8.8,17.3 7.7,16.2 L 6.3,17.6 C 7.8,19.1 9.8,20 12,20 C 16.4,20 20,16.4 20,12 C 20,7.6 16.4,4 12,4 Z"/>
                    <TextBlock Text="上一区域" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 5. 定时 -->
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Click="Timer_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 12,2 C 6.5,2 2,6.5 2,12 C 2,17.5 6.5,22 12,22 C 17.5,22 22,17.5 22,12 C 22,6.5 17.5,2 12,2 Z  M 12,4 C 16.4,4 20,7.6 20,12 C 20,16.4 16.4,20 12,20 C 7.6,20 4,16.4 4,12 C 4,7.6 7.6,4 12,4 Z  M 11.2,7 L 11.2,12.5 L 16,15.3 L 16.8,14 L 12.8,11.7 L 12.8,7 Z"/>
                    <TextBlock Text="定时" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 6. 录屏 -->
            <Button Grid.Column="5" Style="{StaticResource ActionButtonStyle}" Click="Record_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Width="20" Height="20" Margin="0,0,0,4" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 3,6 C 2.4,6 2,6.4 2,7 L 2,17 C 2,17.6 2.4,18 3,18 L 14,18 C 14.6,18 15,17.6 15,17 L 15,13.5 L 19.2,16.8 C 19.8,17.3 20.7,16.8 20.7,16.1 L 20.7,7.9 C 20.7,7.2 19.8,6.7 19.2,7.2 L 15,10.5 L 15,7 C 15,6.4 14.6,6 14,6 Z"/>
                    <TextBlock Text="录屏" FontSize="11.5" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
