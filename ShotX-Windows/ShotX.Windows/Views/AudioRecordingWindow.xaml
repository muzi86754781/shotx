<Window x:Class="ShotX.Windows.Views.AudioRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声音录制 · ShotX"
        Width="440" Height="285"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="pack://application:,,,/Resources/app.ico"
        Background="#F3F6FB">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与最小化 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="19" Background="#FEE2E2">
                    <Path Data="M 10,3 A 2.5,2.5 0 0 1 12.5,5.5 L 12.5,10.5 A 2.5,2.5 0 0 1 7.5,10.5 L 7.5,5.5 A 2.5,2.5 0 0 1 10,3 Z M 5,9.5 A 5,5 0 0 0 15,9.5 M 10,14.5 L 10,17.5 M 7,17.5 L 13,17.5"
                          Stroke="#EF4444" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="声音录制" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="高音质 WAV 音频采集 · 自动保存至下载目录" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Content="─ 最小化" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="26" Padding="10,0" Cursor="Hand"
                    Background="#FFFFFF" Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1"
                    FontSize="11.5" Click="BtnMinimize_Click" ToolTip="最小化到任务栏">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="5" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 中部计时与状态展示 -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,14,0,14" Padding="16,14">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTimer" Text="00:00" FontSize="36" FontWeight="Bold" Foreground="#64748B"
                           FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtStatus" Text="准备就绪，点击下方开始录音" FontSize="12" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部操作按钮栏 (开始、暂停/继续、停止并保存、取消) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="取消" Height="34" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"
                    Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                    FontSize="12" FontWeight="Medium" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="BtnStart" Content="●  开始录音" Height="34" Padding="14,0" Margin="0,0,8,0" Cursor="Hand"
                    Background="#10B981" Foreground="White" BorderThickness="0"
                    FontSize="12" FontWeight="SemiBold" Click="BtnStart_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="BtnPause" Content="⏸  暂停" Height="34" Padding="12,0" Margin="0,0,8,0" Cursor="Hand"
                    Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                    FontSize="12" FontWeight="Medium" Click="BtnPause_Click" IsEnabled="False">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="BtnStop" Content="■  停止并保存" Height="34" Padding="14,0" Cursor="Hand"
                    Background="#EF4444" Foreground="White" BorderThickness="0"
                    FontSize="12" FontWeight="SemiBold" Click="BtnStop_Click" IsEnabled="False">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
