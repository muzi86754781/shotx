<Window x:Class="ShotX.Windows.Views.AudioRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="声音录制 · ShotX"
        Width="360" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="36" Height="36" CornerRadius="18" Background="#FFF2F2">
                <TextBlock Text="🎤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="声音录制" FontSize="16" FontWeight="Bold" Foreground="#1D1D1F" />
                <TextBlock Text="麦克风与系统声音双通道采集" FontSize="11.5" Foreground="#86868B" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E5E5EA" BorderThickness="1" Margin="0,14,0,14" Padding="14">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTimer" Text="00:00" FontSize="32" FontWeight="Bold" Foreground="#FF3B30" FontFamily="Consolas, Monospace" HorizontalAlignment="Center" />
                <TextBlock Text="正在录音中..." FontSize="12" Foreground="#86868B" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Height="32" Padding="14,0" Margin="0,0,8,0"
                    Background="#F2F2F7" Foreground="#1D1D1F" BorderBrush="#D2D2D7" BorderThickness="1"
                    Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="■ 停止并保存" Height="32" Padding="16,0"
                    Background="#FF3B30" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="BtnStop_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>

