<Window x:Class="ShotX.Windows.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 历史记录"
        Width="880" Height="620"
        MinWidth="750" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Search -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="历史记录" FontSize="20" FontWeight="Bold" Foreground="#1D1D1F" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTotalCount" Text="(0 项)" FontSize="13" Foreground="#86868B" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Margin="24,0,24,0" Height="34" VerticalContentAlignment="Center" Padding="10,0"
                     FontSize="13" Background="White" BorderBrush="#D2D2D7" BorderThickness="1"
                     TextChanged="TxtSearch_TextChanged">
                <TextBox.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <Button Grid.Column="2" Content="清空历史" Height="32" Padding="14,0" Background="#FFF2F2" Foreground="#FF3B30"
                    BorderBrush="#FFD6D6" BorderThickness="1" Click="BtnClear_Click">
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: List View -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1" Padding="6">
                <ListBox x:Name="LstEntries" BorderThickness="0" Background="Transparent"
                         SelectionChanged="LstEntries_SelectionChanged"
                         MouseDoubleClick="LstEntries_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="8" Background="#F9F9FB" CornerRadius="6" BorderBrush="#EBEBEF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Thumbnail -->
                                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="4" Background="#EFEFF4" ClipToBounds="True">
                                        <Image Source="{Binding FilePath}" Stretch="UniformToFill" />
                                    </Border>
                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D1D1F" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontSize="11" Foreground="#86868B" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="#007AFF" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right: Preview & Detail Action Bar -->
            <Border Grid.Column="1" Margin="16,0,0,0" Background="White" CornerRadius="10" BorderBrush="#E5E5EA" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Area -->
                    <Border Grid.Row="0" Background="#F9F9FB" CornerRadius="8" Padding="10">
                        <Grid>
                            <Image x:Name="ImgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="TxtPreviewOcr" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" FontSize="13" Padding="8" />
                            <TextBlock x:Name="TxtEmptyPlaceholder" Text="选择左侧记录查看大图预览" FontSize="14" Foreground="#86868B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Actions Bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="BtnCopy" Content="复制到剪贴板 (Enter)" Height="34" Padding="14,0" Margin="0,0,8,0"
                                Background="#007AFF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                                Click="BtnCopy_Click">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnSave" Content="另存为..." Height="34" Padding="14,0" Margin="0,0,8,0"
                                Background="#F2F2F7" Foreground="#1D1D1F" BorderBrush="#D2D2D7" BorderThickness="1"
                                Click="BtnSave_Click">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnOpenFile" Content="在文件夹中显示" Height="34" Padding="12,0" Margin="0,0,8,0"
                                Background="#F2F2F7" Foreground="#1D1D1F" BorderBrush="#D2D2D7" BorderThickness="1"
                                Click="BtnOpenFile_Click">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnDelete" Content="删除" Height="34" Padding="12,0"
                                Background="#FFF2F2" Foreground="#FF3B30" BorderBrush="#FFD6D6" BorderThickness="1"
                                Click="BtnDelete_Click">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
