<Window x:Class="ShotX.Windows.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 翻译"
        Width="530"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app.ico"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 美化对齐的语言选择胶囊下拉框样式 (解决需求 7) -->
        <ControlTemplate x:Key="ModernLangComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="templateBorder"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1"
                          Data="M 0,0 L 4,4 L 8,0"
                          Stroke="#64748B"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateBorder" Property="BorderBrush" Value="#0067C0"/>
                    <Setter TargetName="templateBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#0067C0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="templateBorder" Property="BorderBrush" Value="#0067C0"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#0067C0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LangComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="152"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ModernLangComboToggleTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Medium"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#EFF6FF"/>
                                            <Setter Property="Foreground" Value="#0067C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="itemBd" Property="Background" Value="#E0F2FE"/>
                                            <Setter Property="Foreground" Value="#0067C0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主窗口外壳 -->
    <Border Background="#F3F6FB" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.24" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- 顶栏 -->
                <RowDefinition Height="*"/>   <!-- 原文卡片 -->
                <RowDefinition Height="44"/>  <!-- 语言切换条 (水平严格居中对齐) -->
                <RowDefinition Height="*"/>   <!-- 译文卡片 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏 (可拖动) -->
            <Grid Grid.Row="0" MouseDown="TopBar_MouseDown" Background="Transparent" Margin="10,4,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：钉住图钉 + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPin" Style="{StaticResource IconBtnStyle}" Click="BtnPin_Click" ToolTip="固定在最前">
                        <Path x:Name="PinPath" Width="13" Height="13" Stretch="Uniform" Fill="#0067C0"
                              Data="M 9,2 L 15,2 L 15,4 L 13,4 L 13,9 L 16,12 L 16,14 L 13,14 L 13,21 L 11,21 L 11,14 L 8,14 L 8,12 L 11,9 L 11,4 L 9,4 Z"/>
                    </Button>
                    <TextBlock Text="ShotX 智能翻译" FontSize="12.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- 右侧：历史、设置、关闭 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtnStyle}" Click="BtnHistory_Click" ToolTip="查看翻译历史记录">
                        <Path Data="M 10,3 A 7,7 0 1 1 3,10 L 5,10 A 5,5 0 1 0 10,5 L 10,7 L 6.5,4 L 10,1 L 10,3 Z M 9.5,6.5 L 9.5,10.5 L 12.5,12"
                              Stroke="#475569" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource IconBtnStyle}" Margin="4,0,0,0" Click="BtnSettings_Click" ToolTip="翻译偏好设置">
                        <TextBlock Text="⚙️" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource IconBtnStyle}" Margin="4,0,0,0" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 原文输入卡片 (白色圆角) -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12,2,12,4">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="TxtSource" BorderThickness="0" Background="Transparent"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontSize="13.5" Foreground="#0F172A" TextChanged="TxtSource_TextChanged"/>
                        <TextBlock x:Name="TxtSourcePlaceholder" Text="输入要翻译的文字，或选中屏幕文字后使用划词翻译 (Alt+Shift+F)..."
                                   FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" Margin="2,1,0,0"
                                   Visibility="Visible" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconBtnStyle}" Width="24" Height="24" Click="BtnSpeakSource_Click" ToolTip="朗读原文">
                                <TextBlock Text="🔊" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource IconBtnStyle}" Width="24" Height="24" Margin="4,0,0,0" Click="BtnCopySource_Click" ToolTip="复制原文">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TxtCharCount" Text="0 字" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#94A3B8"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 中间语言选择条 (“自动检测”与“自动选择”严格同行居中对齐，胶囊卡片美化) -->
            <Grid Grid.Row="2" Margin="12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbSourceLang" Grid.Column="0" Style="{StaticResource LangComboStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                          SelectionChanged="Lang_SelectionChanged">
                    <ComboBoxItem Content="自动检测" IsSelected="True"/>
                    <ComboBoxItem Content="英语"/>
                    <ComboBoxItem Content="中文 (简体)"/>
                    <ComboBoxItem Content="日语"/>
                    <ComboBoxItem Content="韩语"/>
                    <ComboBoxItem Content="法语"/>
                    <ComboBoxItem Content="德语"/>
                    <ComboBoxItem Content="俄语"/>
                    <ComboBoxItem Content="西班牙语"/>
                </ComboBox>

                <Button Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center" Cursor="Hand"
                        Click="BtnSwap_Click" ToolTip="互换源语言与目标语言">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="swapBd" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="16">
                                <TextBlock Text="⇄" FontSize="14" FontWeight="Bold" Foreground="#0067C0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="swapBd" Property="Background" Value="#EFF6FF"/>
                                    <Setter TargetName="swapBd" Property="BorderBrush" Value="#0067C0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <ComboBox x:Name="CmbTargetLang" Grid.Column="2" Style="{StaticResource LangComboStyle}"
                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                          SelectionChanged="Lang_SelectionChanged">
                    <ComboBoxItem Content="自动选择" IsSelected="True"/>
                    <ComboBoxItem Content="中文 (简体)"/>
                    <ComboBoxItem Content="英语"/>
                    <ComboBoxItem Content="日语"/>
                    <ComboBoxItem Content="韩语"/>
                    <ComboBoxItem Content="法语"/>
                    <ComboBoxItem Content="德语"/>
                    <ComboBoxItem Content="俄语"/>
                    <ComboBoxItem Content="西班牙语"/>
                </ComboBox>
            </Grid>

            <!-- 4. 译文输出卡片 (白色圆角) -->
            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12,4,12,12">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部服务提供方标签 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0067C0" CornerRadius="8" Width="15" Height="15" Margin="0,0,6,0">
                            <TextBlock Text="译" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="谷歌翻译 (免密钥 · 默认推荐)" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                    </StackPanel>

                    <TextBox x:Name="TxtResult" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="13.5" Foreground="#0F172A" Margin="0,4,0,0"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource IconBtnStyle}" Width="24" Height="24" Click="BtnSpeakResult_Click" ToolTip="朗读译文">
                            <TextBlock Text="🔊" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconBtnStyle}" Width="24" Height="24" Margin="4,0,0,0" Click="BtnCopyResult_Click" ToolTip="复制译文">
                            <TextBlock Text="📋" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
