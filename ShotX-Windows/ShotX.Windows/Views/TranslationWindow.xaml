<Window x:Class="ShotX.Windows.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 翻译"
        Width="520"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A000000"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LangComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- 主窗口外壳 (图 5 浅灰圆角毛玻璃质感) -->
    <Border Background="#F2EBEFF4" CornerRadius="12" BorderBrush="#D8DCE4" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>  <!-- 顶栏 -->
                <RowDefinition Height="*"/>   <!-- 原文卡片 -->
                <RowDefinition Height="36"/>  <!-- 语言切换条 -->
                <RowDefinition Height="*"/>   <!-- 译文卡片 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶栏 (可拖动) -->
            <Grid Grid.Row="0" MouseDown="TopBar_MouseDown" Background="Transparent" Margin="8,4,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：钉住图钉 -->
                <Button x:Name="BtnPin" Grid.Column="0" Style="{StaticResource IconBtnStyle}" Click="BtnPin_Click" ToolTip="固定在最前">
                    <Path x:Name="PinPath" Width="13" Height="13" Stretch="Uniform" Fill="#007AFF"
                          Data="M 9,2 L 15,2 L 15,4 L 13,4 L 13,9 L 16,12 L 16,14 L 13,14 L 13,21 L 11,21 L 11,14 L 8,14 L 8,12 L 11,9 L 11,4 L 9,4 Z"/>
                </Button>

                <!-- 右侧：历史、设置、关闭 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconBtnStyle}" Click="BtnHistory_Click" ToolTip="历史记录">
                        <TextBlock Text="🕒" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource IconBtnStyle}" Margin="4,0,0,0" Click="BtnSettings_Click" ToolTip="翻译偏好">
                        <TextBlock Text="⚙️" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource IconBtnStyle}" Margin="4,0,0,0" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 原文输入卡片 (白色圆角) -->
            <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E3EA" BorderThickness="1" Margin="12,2,12,4">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtSource" Grid.Row="0" BorderThickness="0" Background="Transparent"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="13.5" Foreground="#222222" TextChanged="TxtSource_TextChanged"/>

                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconBtnStyle}" Width="22" Height="22" Click="BtnSpeakSource_Click" ToolTip="朗读原文">
                                <TextBlock Text="🔊" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource IconBtnStyle}" Width="22" Height="22" Margin="4,0,0,0" Click="BtnCopySource_Click" ToolTip="复制原文">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="TxtCharCount" Text="0 字" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#999999"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. 中间语言选择条 -->
            <Grid Grid.Row="2" Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbSourceLang" Grid.Column="0" Style="{StaticResource LangComboStyle}" HorizontalAlignment="Right" Margin="0,0,8,0" SelectionChanged="Lang_SelectionChanged">
                    <ComboBoxItem Content="自动检测" IsSelected="True"/>
                    <ComboBoxItem Content="英语"/>
                    <ComboBoxItem Content="中文 (简体)"/>
                    <ComboBoxItem Content="日语"/>
                    <ComboBoxItem Content="韩语"/>
                    <ComboBoxItem Content="法语"/>
                    <ComboBoxItem Content="德语"/>
                    <ComboBoxItem Content="俄语"/>
                    <ComboBoxItem Content="西班牙语"/>
                </ComboBox>

                <Button Grid.Column="1" Style="{StaticResource IconBtnStyle}" Width="28" Height="28" Click="BtnSwap_Click" ToolTip="互换语言">
                    <TextBlock Text="⇆" FontSize="14" FontWeight="Bold" Foreground="#007AFF"/>
                </Button>

                <ComboBox x:Name="CmbTargetLang" Grid.Column="2" Style="{StaticResource LangComboStyle}" HorizontalAlignment="Left" Margin="8,0,0,0" SelectionChanged="Lang_SelectionChanged">
                    <ComboBoxItem Content="自动选择" IsSelected="True"/>
                    <ComboBoxItem Content="中文 (简体)"/>
                    <ComboBoxItem Content="英语"/>
                    <ComboBoxItem Content="日语"/>
                    <ComboBoxItem Content="韩语"/>
                    <ComboBoxItem Content="法语"/>
                    <ComboBoxItem Content="德语"/>
                    <ComboBoxItem Content="俄语"/>
                    <ComboBoxItem Content="西班牙语"/>
                </ComboBox>
            </Grid>

            <!-- 4. 译文输出卡片 (白色圆角) -->
            <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E0E3EA" BorderThickness="1" Margin="12,4,12,12">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部服务提供方标签 (图 5 紧密复刻) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#007AFF" CornerRadius="8" Width="14" Height="14" Margin="0,0,6,0">
                            <TextBlock Text="译" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="谷歌翻译 (免密钥 · 默认推荐)" FontSize="11" FontWeight="SemiBold" Foreground="#555555"/>
                    </StackPanel>

                    <TextBox x:Name="TxtResult" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="13.5" Foreground="#111111" Margin="0,4,0,0"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource IconBtnStyle}" Width="22" Height="22" Click="BtnSpeakResult_Click" ToolTip="朗读译文">
                            <TextBlock Text="🔊" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource IconBtnStyle}" Width="22" Height="22" Margin="4,0,0,0" Click="BtnCopyResult_Click" ToolTip="复制译文">
                            <TextBlock Text="📋" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
