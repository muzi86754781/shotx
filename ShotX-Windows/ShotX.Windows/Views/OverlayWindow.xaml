<Window x:Class="ShotX.Windows.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ShotX.Windows.Views"
        Title="ShotX 截屏"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel">
    <Grid x:Name="RootGrid">
        <!-- 背景屏幕快照 -->
        <Image x:Name="ImgSnapshot" Stretch="Fill" />

        <!-- 绘制画板（遮罩、标注、选框、工具栏全部在此渲染） -->
        <views:SelectionCanvas x:Name="OverlayCanvas" Background="Transparent">
            <!-- 实时文字输入编辑框 (可编辑已有文字或新输入) -->
            <TextBox x:Name="TxtInlineEditor"
                     Visibility="Collapsed"
                     Background="#40FFFFFF"
                     BorderBrush="#007AFF"
                     BorderThickness="1.5"
                     Padding="4"
                     AcceptsReturn="True"
                     KeyDown="TxtInlineEditor_KeyDown"
                     LostFocus="TxtInlineEditor_LostFocus" />
        </views:SelectionCanvas>
    </Grid>
</Window>
