<Window x:Class="ShotX.Windows.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShotX 倒计时"
        Width="140" Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Border Background="#D0000000" CornerRadius="70" BorderBrush="#80FFFFFF" BorderThickness="2">
        <Grid>
            <TextBlock x:Name="TxtNumber" Text="3" FontSize="64" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="ShotX 定时截图" FontSize="11" Foreground="#CCCCCC"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" />
        </Grid>
    </Border>
</Window>
